    <material name="panda_black" rgba="0.08 0.09 0.11 1"/>
    <material name="peg" rgba="0.90 0.50 0.08 1" metallic="0.7" roughness="0.25"/>
    <material name="socket" rgba="0.15 0.45 0.72 1" metallic="0.25" roughness="0.35"/>
