    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <joint armature="0.08" damping="1.5" frictionloss="0.08"/>
    <geom condim="4" friction="0.8 0.02 0.002" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <motor ctrllimited="true" ctrlrange="-87 87"/>
    <default class="arm_visual">
      <geom contype="0" conaffinity="0" group="2" type="capsule" rgba="0.92 0.92 0.95 1"/>
    </default>
    <default class="arm_collision">
      <!-- Collision bits keep adjacent capsules from self-locking while retaining table contact. -->
      <geom group="3" type="capsule" contype="2" conaffinity="0" rgba="0.15 0.15 0.18 0.28"/>
    </default>
  </default>

  <asset>
